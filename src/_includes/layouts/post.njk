---
layout: layouts/base.njk
---
<article class="post wrap narrow">
  <div class="post-header">
    <p class="meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | displayDate }}</time>
      {%- if author %} · {{ author }}{% endif %}
    </p>
    <h1>{{ title }}</h1>
  </div>
  <div class="post-body">
{{ content | safe }}
  </div>
  <p class="back"><a href="/blog/">← Back to the blog</a></p>
</article>
