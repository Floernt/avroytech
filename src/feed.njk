---
permalink: /blog/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title }} — Blog</title>
    <link>{{ site.url }}/blog/</link>
    <description>Explore Avroy Tech insights on EU crypto regulation, AML, MiCA, DORA, AI law, privacy, licensing, and emerging blockchain technology.</description>
    <language>en</language>
    {%- for post in collections.posts %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ post.url | absoluteUrl(site.url) }}</link>
      <guid>{{ post.url | absoluteUrl(site.url) }}</guid>
      <pubDate>{{ post.date.toUTCString() }}</pubDate>
      {%- if post.data.description %}
      <description>{{ post.data.description }}</description>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
