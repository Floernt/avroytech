---
layout: layouts/base.njk
title: Blog
seoTitle: "Blog | Explore Tech Regulation Insights — avroy tech"
description: "Explore Avroy Tech insights on EU crypto regulation, AML, MiCA, DORA, AI law, privacy, licensing, and emerging blockchain technology."
permalink: /blog/
---
<section class="section white">
  <div class="wrap">
    <ul class="blog-grid">
      {%- for post in collections.posts %}
      <li>
        <a class="thumb" href="{{ post.url }}">
          {%- if post.data.image %}<img src="{{ post.data.image }}" alt="" loading="lazy">{% endif -%}
        </a>
        <p class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | displayDate }}</time></p>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
